# Template: scripts/pi/install_services.sh fills in __USER__ and __DIR__.
[Unit]
Description=Gesture remote: Bluetooth LE media keys for the phone
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__DIR__/.venv/bin/python -m gesturectl.hid --config config/car.yaml serve --log-file logs/hid.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
